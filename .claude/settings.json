{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(**/.env)",
      "Read(**/*.pem)",
      "Read(**/*-key.json)",
      "Read(**/gha-creds-*.json)",
      "Read(./.overleaf-token)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["./.env", "./.env.local", "./.env.production", "./**/.env", "./**/*.pem", "./**/*-key.json", "./**/gha-creds-*.json"],
      "allowWrite": ["~/.cache/uv"]
    },
    "network": {
      "allowedDomains": ["pypi.org", "files.pythonhosted.org", "github.com", "api.github.com"]
    }
  }
}
