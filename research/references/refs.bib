	author = {Banzhaf, Spencer and Ma, Lala and Timmins, Christopher},
	month = feb,
	year = {2019},
	keywords = {Air Pollution; Water Pollution; Noise; Hazardous Waste; Solid Waste; Recycling, Economics of Minorities, Races, Indigenous Peoples, and Immigrants; Non-labor Discrimination, Environmental Economics: Government Policy, Equity, Justice, Inequality, and Other Normative Criteria and Measurement, Equity, Justice, Inequality, and Other Normative Criteria and Measurement, Economics of Minorities, Races, Indigenous Peoples, and Immigrants, Hazardous Waste, Noise, Non-labor Discrimination, Air Pollution, Recycling, Environmental Economics: Government Policy, Recycling, Environmental Economics: Government Policy, Air Pollution, Solid Waste, Water Pollution, core},
