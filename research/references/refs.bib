	pages = {1--36},
}

@article{benyishayIndigenousLandRights2017,
	series = {Special issue on environmental economics in developing countries},
	title = {Indigenous land rights and deforestation: {Evidence} from the {Brazilian} {Amazon}},
	volume = {86},
	issn = {0095-0696},
	shorttitle = {Indigenous land rights and deforestation},
	url = {https://www.sciencedirect.com/science/article/pii/S0095069617304813},
	doi = {10.1016/j.jeem.2017.07.008},
	abstract = {Concerns over the expropriation of and encroachment on indigenous communities' lands have led to greater formalization of these communities' rights in a number of developing countries. We study whether formalization of indigenous communities' land rights affects the rate of deforestation in both the short and medium terms. Beginning in 1995, the Government of Brazil formalized the rights of several hundred indigenous communities whose lands cover more than 40 million hectares in the Amazon region and provided support for these rights’ enforcement. We study the program's impacts using a long time-series of satellite-based forest cover data. Using both plausibly exogenous variation in the timing of formalization and matched samples of treated and comparison communities, we find no effect of these protections on satellite-based greenness measures. This is true even for communities that received support for surveillance and enforcement of these rights. Notably, we observe low counterfactual rates of deforestation on communities' lands between 1982 and 2010, suggesting that indigenous land rights programs should not uniformly be justified on the basis of their forest protection, at least in the medium term.},
	urldate = {2024-06-11},
	journal = {Journal of Environmental Economics and Management},
	author = {BenYishay, Ariel and Heuser, Silke and Runfola, Daniel and Trichler, Rachel},
	month = nov,
	year = {2017},
	keywords = {Forest cover, H41, Impact evaluation, Land tenure, O13, Q15, Q23, Satellite-based},
	pages = {29--47},
}

