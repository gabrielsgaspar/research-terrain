# Normalise line endings so shell scripts and workflows work the same on
# Windows, WSL and GitHub's Linux runners.
* text=auto eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.parquet binary
*.zip binary
# Fixtures are byte-for-byte cuts of source files (TSE uses Latin-1 and
# CRLF); never convert them.
data/fixtures/** -text
