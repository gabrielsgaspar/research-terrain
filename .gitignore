# Python
__pycache__/
*.py[cod]
*.egg-info/
# Anchored to the repository root: an unanchored `build/` would also hide
# pipeline/build/ and data/manifests/build/.
/build/
/dist/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node (not used here; uv comes from astral.sh, not npm)
node_modules/
package-lock.json

# Notebooks
.ipynb_checkpoints/
__marimo__/

# Secrets and credentials: never in git
.env
.env.*
!.env.example
*.pem
*-key.json
gha-creds-*.json
.overleaf-token

# Data lives in GCS, never in git, anywhere in the tree (legacy/ included).
# Small text fixtures in data/fixtures/ are the only exception.
*.parquet
*.csv
*.tsv
*.dta
*.sav
*.rds
*.xlsx
*.xls
*.zip
*.gz
*.tif
*.tiff
*.gpkg
*.shp
*.dbf
*.feather
*.pkl
*.npy
!data/fixtures/**
/local/
/_local/

# Agent harness logs
.loop/
.agent-*/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
